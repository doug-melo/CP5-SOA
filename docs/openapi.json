{
  "openapi": "3.0.3",
  "info": {
    "title": "CP5 - API de Pedidos",
    "version": "1.0.0",
    "description": "Pedidos mantidos em RAM durante a execução de php artisan api:serve."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "paths": {
    "/api/pedidos": {
      "post": {
        "summary": "Criar pedido",
        "operationId": "criarPedido",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "cliente",
                  "descricao",
                  "valor"
                ],
                "properties": {
                  "cliente": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "descricao": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "valor": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 999999999.99,
                    "multipleOf": 0.01
                  }
                }
              },
              "example": {
                "cliente": "Douglas Melo",
                "descricao": "Teclado mecânico",
                "valor": 199.9
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pedido criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pedido"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Caminho para consultar o pedido"
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "description": "JSON malformado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Content-Type diferente de application/json",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Falha na validação",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message",
                    "errors"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/pedidos/{id}": {
      "get": {
        "summary": "Consultar pedido pelo identificador",
        "operationId": "consultarPedido",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "UUID retornado ao criar; qualquer identificador ausente retorna 404."
          }
        ],
        "responses": {
          "200": {
            "description": "Pedido encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pedido"
                }
              }
            }
          },
          "404": {
            "description": "Pedido não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pedido": {
        "type": "object",
        "required": [
          "id",
          "cliente",
          "descricao",
          "valor",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cliente": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "valor": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$",
            "example": "199.90"
          },
          "status": {
            "type": "string",
            "enum": [
              "CRIADO"
            ]
          }
        }
      }
    }
  }
}
